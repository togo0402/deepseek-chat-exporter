{
  "manifest_version": 3,
  "name": "DeepSeek 对话导出助手",
  "version": "1.0.0",
  "description": "在 chat.deepseek.com 一键把当前对话导出为 Markdown，支持按轮勾选、可选保留深度思考。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["https://chat.deepseek.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "run_at": "document_idle",
      "css": ["styles/panel.css"],
      "js": [
        "src/shared.js",
        "src/api.js",
        "src/messages.js",
        "src/markdown.js",
        "src/ui.js",
        "src/main.js"
      ]
    }
  ]
}
